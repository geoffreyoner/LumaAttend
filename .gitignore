# ============================================
#  LumaAttend — .gitignore
# ============================================

# ----- Secrets & Environment -----
.env
.env.local
.env.*.local
*.env

# ----- Database -----
instance/*.db
instance/*.db-wal
instance/*.db-shm
instance/*.sqlite
instance/*.sqlite3
*.db-journal
!instance/.gitkeep

# ----- ONNX Models (optional; uncomment to exclude) -----
# models/*.onnx
# models/*.ort
!models/.gitkeep

# ----- Backups -----
.backup_*/
.backup
*.bak
*.backup

# ----- Installer temp files -----
.admin_setup.py
.luma_admin.py

# ----- Python -----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ----- Virtual Env -----
venv/
env/
ENV/
.venv/
lumaenv/
.python-version
pip-log.txt
pip-delete-this-directory.txt

# ----- Testing -----
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
*.cover
.hypothesis/

# ----- Logs -----
*.log
logs/
luma.log
nohup.out

# ----- Editor -----
.vscode/
.idea/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace
.project
.pydevproject

# ----- OS -----
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ----- Temp -----
*.tmp
*.temp
tmp/
temp/
.cache/

# ----- Node -----
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ----- Termux -----
.termux/
# Extra safety
instance/*.db
instance/*.db-wal
instance/*.db-shm
.env
.env.*
!.env.example
