# ============================================
#  LumaAttend — Environment template
#  Copy ke .env lalu ubah sesuai kebutuhan:
#      cp .env.example .env
# ============================================

# WAJIB: kunci Flask session
# Generate acak dengan:
#   python -c "import secrets; print(secrets.token_hex(32))"
LUMA_SECRET_KEY=change-this-to-a-random-64-char-hex-string

# Path database SQLite (relatif ke folder project)
LUMA_DB_PATH=instance/lumaattend.db

# Zona waktu absensi
LUMA_TIMEZONE=Asia/Jakarta

# Threshold cosine similarity untuk face recognition
# Naikkan (0.40+) untuk lebih ketat, turunkan (0.30) kalau user sering ditolak
LUMA_FACE_THRESHOLD=0.363

# Confidence minimum deteksi wajah YuNet (0.0 – 1.0)
LUMA_FACE_DET_CONF=0.7

# Rate limiting login
LUMA_MAX_LOGIN_ATTEMPTS=5
LUMA_LOGIN_WINDOW=300

# Cooldown absensi per user (detik)
LUMA_ATT_COOLDOWN=60

# Kiosk mode (1=aktif, 0=nonaktif)
LUMA_KIOSK_MODE=0

# Cooldown scan per user di kiosk (detik)
LUMA_KIOSK_SCAN_COOLDOWN=15

# Minimum interval check-in → check-out di kiosk (menit)
LUMA_KIOSK_MIN_CHECKOUT_MINUTES=60
